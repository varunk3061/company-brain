MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=company_brain
JWT_SECRET_KEY=change-me-to-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Seed System Administrator, created only on a brand-new install (min 12 chars)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional, legacy: folder scans (POST /api/documents/scan-folder) are confined to this absolute path
DOCUMENTS_ROOT=
# Cloudflare R2 private bucket for uploaded PDFs (keys stay on the backend; never commit real values)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=company-brain-docs
# Upload limit per PDF, and lifetime of "view PDF" links (seconds, max 604800)
MAX_UPLOAD_MB=25
PRESIGNED_URL_TTL_SECONDS=300
# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
