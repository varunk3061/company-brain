MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=company_brain
JWT_SECRET_KEY=change-me-to-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Seed System Administrator, created only on a brand-new install (min 12 chars)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Folder scans are confined to this absolute path
DOCUMENTS_ROOT=
# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
